MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DB_NAME
PORT=3000

# Supabase Storage. Keep this key on the backend only.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_BUCKET=materials

# Google OAuth for "Sign in with Google".
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
SESSION_SECRET=replace-with-a-long-random-string
BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Android 15+ / installed PWA safety:
# Use HTTPS in production and set both values to your public app URL.
# Example:
# BASE_URL=https://your-domain.com
# CORS_ORIGIN=https://your-domain.com,https://localhost,capacitor://localhost,ionic://localhost

MAX_STORED_CONTENT_CHARS=100000

# Cashfree subscriptions.
# Use sandbox while testing, production only after Cashfree onboarding/domain whitelisting is complete.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=YOUR_CASHFREE_APP_ID
CASHFREE_SECRET_KEY=YOUR_CASHFREE_SECRET_KEY
CASHFREE_API_VERSION=2025-01-01
PUBLIC_APP_URL=http://localhost:3000
CASHFREE_RETURN_URL=http://localhost:3000/home.html?payment_return=cashfree
SUBSCRIPTION_PLAN_NAME=Xyron Notes Pro
SUBSCRIPTION_AMOUNT=99
SUBSCRIPTION_MAX_AMOUNT=99
SUBSCRIPTION_INTERVAL_TYPE=MONTH
SUBSCRIPTION_INTERVALS=1
SUBSCRIPTION_MAX_CYCLES=12
SUBSCRIPTION_AUTH_AMOUNT=1
SUBSCRIPTION_FIRST_CHARGE_DELAY_DAYS=1
SUBSCRIPTION_LOCAL_ACCESS_CYCLES=1
CASHFREE_DEFAULT_CUSTOMER_EMAIL=test@example.com
CASHFREE_DEFAULT_CUSTOMER_PHONE=9999999999
